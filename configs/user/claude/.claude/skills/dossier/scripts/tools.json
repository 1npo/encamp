   ],
   "via": "dotnet-tool",
   "package": "scip-dotnet",
   "version": "0.2.16",
   "published": "2026-10-21",
   "nupkg": {
    "url": "https://api.nuget.org/v3-flatcontainer/scip-dotnet/0.2.16/scip-dotnet.0.2.16.nupkg",
    "sha512": "UUaPQCnqIWFYGXaKtgjieBP0WR0uH8L55pwqhtOJH/3El+zCF5/cXXX30oYXrfKYZibDjun2knU8r1212i+eWw==",
