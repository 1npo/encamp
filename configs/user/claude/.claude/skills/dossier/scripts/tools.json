 ],
 "restore": [
  {
   "ecosystem": "python",
   "lockfile": "uv.lock",
   "command": [
    "uv",
    "sync",
    "--frozen"
   ],
   "enabled": true,
   "source": "https://docs.astral.sh/uv/reference/cli/"
  },
  {
   "ecosystem": "npm",
   "lockfile": "package-lock.json",
   "command": [
    "npm",
    "ci",
    "--ignore-scripts",
    "--no-audit",
    "--no-fund"
   ],
   "enabled": true,
   "source": "https://docs.npmjs.com/cli/v11/commands/npm-ci",
   "nested": true
  },
  {
   "ecosystem": "yarn",
   "lockfile": "yarn.lock",
   "nested": true,
   "enabled": true,
   "auth": "npm",
   "command": [
    "node",
    "{js_tools}/node_modules/yarn/bin/yarn.js",
    "install",
    "--frozen-lockfile",
    "--ignore-scripts",
    "--non-interactive"
   ],
   "berry_command": [
    "node",
    "{js_tools}/node_modules/@yarnpkg/cli-dist/bin/yarn.js",
    "install",
    "--immutable",
    "--mode=skip-build"
   ],
   "source": "https://yarnpkg.com/cli/install"
  },
  {
   "ecosystem": "pnpm",
   "lockfile": "pnpm-lock.yaml",
   "nested": true,
   "enabled": true,
   "auth": "npm",
   "command": [
    "node",
    "{js_tools}/node_modules/pnpm/bin/pnpm.mjs",
    "install",
    "--frozen-lockfile",
    "--ignore-scripts",
    "--store-dir",
    "{pnpm_store}"
   ],
   "source": "https://pnpm.io/cli/install"
  },
  {
   "ecosystem": "nuget",
   "lockfile": "packages.lock.json",
   "command": [
    "dotnet",
    "restore",
    "--locked-mode"
   ],
   "enabled": false,
   "source": "https://learn.microsoft.com/en-us/dotnet/core/tools/dotnet-restore"
  }
 ]
}
